{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormMCP",
  "version": "0.8.4",
  "identifier": "ai.nodemode.formmcp",
  "build": {
    "devUrl": "http://localhost:5620",
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src formext: http://formext.localhost"
    },
    "windows": [
      { "label": "splash", "title": "FormMCP", "url": "splash.html", "width": 360, "height": 200, "resizable": false, "decorations": false, "center": true, "transparent": true, "shadow": false, "visible": false }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "One connection from Claude Code, Codex and Cursor to the Form family",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. GPL-3.0-only",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
